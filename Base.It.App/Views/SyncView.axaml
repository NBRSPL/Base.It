<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Base.It.App.ViewModels"
             xmlns:cfg="using:Base.It.Core.Config"
             x:Class="Base.It.App.Views.SyncView"
             x:DataType="vm:SyncViewModel">

    <!-- Single-object sync. Mirrors Batch's compact layout so muscle memory
         carries between the two: profile button + source autocomplete +
         swap + targets popover on row 0; object name + DACPAC + actions
         on row 1; last-run info card on row 2; status row 3. -->
    <DockPanel>
        <ProgressBar DockPanel.Dock="Top" Classes="pageLoader" IsVisible="{Binding IsBusy}"/>

        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- ──────────────────── Row 0: context bar ──────────────────── -->
            <!-- Same shape as Batch: From [source] → To [search + selected chips]
                 [⇄ swap @ end]. Source = single-pick. Target = many-pick via a
                 searchable AutoCompleteBox + a chip strip so the active selection
                 is always visible. -->
            <Border Grid.Row="0" Classes="toolbar" Margin="0,0,0,6">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">

                    <!-- Profile: tucked into a star button. Click opens a flyout
                         with the saved-pair combo + Save / Delete actions. -->
                    <Button Grid.Column="0" Padding="10,4" MinHeight="30"
                            ToolTip.Tip="Profiles — saved source/target pairs">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="★" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.AccentBrush}"/>
                            <TextBlock Text="Profile" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Spacing="8" MinWidth="280">
                                    <TextBlock Text="Saved source/target pairs"
                                               FontSize="11" Opacity="0.7"/>
                                    <ComboBox ItemsSource="{Binding Profiles}"
                                              SelectedItem="{Binding SelectedProfile}"
                                              HorizontalAlignment="Stretch"
                                              PlaceholderText="None — pick a saved pair">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="vm:EndpointProfile">
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="Save current…"
                                                Command="{Binding SaveAsProfileCommand}"/>
                                        <Button Content="Delete"
                                                Command="{Binding DeleteProfileCommand}"
                                                IsEnabled="{Binding SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </StackPanel>
                                    <TextBlock Classes="subtle" TextWrapping="Wrap"
                                               Text="Picking a profile sets source + ticks the saved targets in one click."/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- "From" pill — source autocomplete + colour badge. -->
                    <Border Grid.Column="1" Margin="10,0,0,0"
                            Background="{DynamicResource App.ElevatedBgBrush}"
                            BorderBrush="{DynamicResource App.StrokeBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <TextBlock Text="From" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.85" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.AccentBrush}"/>
                        <Border Classes="dropdownShell">
                        <Grid ColumnDefinitions="*,Auto">
                        <AutoCompleteBox Grid.Column="0" x:Name="SourceBox" MinWidth="200"
                                         MinimumPrefixLength="0" FilterMode="Contains"
                                         BorderThickness="0" Background="Transparent"
                                         ItemsSource="{Binding SourceCandidateEndpoints}"
                                         SelectedItem="{Binding SelectedSourceEndpoint, Mode=TwoWay}"
                                         GotFocus="OnEndpointPickerGotFocus"
                                         Watermark="Source">
                            <AutoCompleteBox.ItemTemplate>
                                <DataTemplate DataType="vm:EndpointPick">
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                        <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{Binding Color, Converter={x:Static vm:ColorStringBrushConverter.Instance}}"
                                                 Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Label}" FontSize="12"/>
                                            <TextBlock Text="{Binding SubLabel}"
                                                       FontSize="10" Opacity="0.55"
                                                       IsVisible="{Binding ShowSubLabel}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </AutoCompleteBox.ItemTemplate>
                        </AutoCompleteBox>
                        <Button Grid.Column="1"
                                Padding="8,0" MinWidth="0" MinHeight="0"
                                Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Stretch"
                                Click="OnSourceChevronClick"
                                ToolTip.Tip="Show all sources">
                            <TextBlock Text="▾" FontSize="11" Opacity="0.6"
                                       VerticalAlignment="Center"/>
                        </Button>
                        </Grid>
                        </Border>
                        <Border Classes="badge"
                                Background="{Binding SourceProfile.Color, Converter={x:Static vm:ColorStringBrushConverter.Instance}}"
                                IsVisible="{Binding SourceProfile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SourceProfile.Label}"/>
                        </Border>
                    </StackPanel>
                    </Border>

                    <!-- Arrow linking From → To. -->
                    <TextBlock Grid.Column="2" Text="→" FontSize="22" FontWeight="Bold"
                               Margin="10,0,10,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.AccentBrush}"/>

                    <!-- "To" pill — same visual treatment as the From pill. -->
                    <Border Grid.Column="3"
                            Background="{DynamicResource App.ElevatedBgBrush}"
                            BorderBrush="{DynamicResource App.StrokeBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="8,4" ClipToBounds="True">
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="To" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.85" VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource App.AccentBrush}"/>
                        <Border DockPanel.Dock="Left" Classes="dropdownShell" Margin="0,0,6,0">
                        <Grid ColumnDefinitions="*,Auto">
                        <AutoCompleteBox Grid.Column="0" x:Name="TargetAddBox" MinWidth="180"
                                         MinimumPrefixLength="0" FilterMode="Contains"
                                         BorderThickness="0" Background="Transparent"
                                         ItemsSource="{Binding TargetCandidateEndpoints}"
                                         SelectedItem="{Binding NextTargetEndpoint, Mode=TwoWay}"
                                         GotFocus="OnEndpointPickerGotFocus"
                                         SelectionChanged="OnTargetAddSelectionChanged"
                                         Watermark="Add target">
                            <AutoCompleteBox.ItemTemplate>
                                <DataTemplate DataType="vm:EndpointPick">
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                        <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{Binding Color, Converter={x:Static vm:ColorStringBrushConverter.Instance}}"
                                                 Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Label}" FontSize="12"/>
                                            <TextBlock Text="{Binding SubLabel}"
                                                       FontSize="10" Opacity="0.55"
                                                       IsVisible="{Binding ShowSubLabel}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </AutoCompleteBox.ItemTemplate>
                        </AutoCompleteBox>
                        <Button Grid.Column="1"
                                Padding="8,0" MinWidth="0" MinHeight="0"
                                Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Stretch"
                                Click="OnTargetChevronClick"
                                ToolTip.Tip="Show all targets">
                            <TextBlock Text="▾" FontSize="11" Opacity="0.6"
                                       VerticalAlignment="Center"/>
                        </Button>
                        </Grid>
                        </Border>
                        <!-- Clear-all icon — anchored to the LEFT of the chip strip. -->
                        <Button DockPanel.Dock="Left"
                                Padding="6,2" MinWidth="0" MinHeight="22"
                                Margin="0,0,6,0"
                                IsVisible="{Binding TargetSelectedCount}"
                                Command="{Binding ClearTargetsCommand}"
                                ToolTip.Tip="Clear all targets">
                            <TextBlock Text="&#xE894;"
                                       FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                       FontSize="11" Opacity="0.85"/>
                        </Button>
                        <!-- "+N more" overflow pill — anchored to the right. -->
                        <Button DockPanel.Dock="Right"
                                Padding="6,2" MinHeight="22" FontSize="11"
                                Margin="6,0,0,0"
                                IsVisible="{Binding HasCheckedTargetsOverflow}"
                                ToolTip.Tip="More selected targets — click to see / remove">
                            <TextBlock Text="{Binding CheckedTargetsOverflowCount, StringFormat='+{0} more'}"
                                       FontSize="10" FontWeight="SemiBold"/>
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <ItemsControl ItemsSource="{Binding CheckedTargetsOverflow}" MinWidth="220">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:TargetPickVm">
                                                <Border Classes="badge" Margin="2"
                                                        Background="{Binding Color, Converter={x:Static vm:ColorStringBrushConverter.Instance}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                        <Button Click="OnRemoveTargetClick" Tag="{Binding}"
                                                                Padding="3,0" MinWidth="0" MinHeight="0"
                                                                Background="Transparent" BorderThickness="0">
                                                            <TextBlock Text="✕" FontSize="10"
                                                                       Foreground="White" Opacity="0.85"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <!-- Chip strip fills the middle, wrapped in a ScrollViewer. -->
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CheckedTargetsVisible}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:TargetPickVm">
                                        <Border Classes="badge"
                                                Background="{Binding Color, Converter={x:Static vm:ColorStringBrushConverter.Instance}}"
                                                VerticalAlignment="Center"
                                                Padding="6,2"
                                                ToolTip.Tip="{Binding Label}">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="White"/>
                                                <Button Click="OnRemoveTargetClick" Tag="{Binding}"
                                                        Padding="3,0" MinWidth="0" MinHeight="0"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTip.Tip="Remove this target">
                                                    <TextBlock Text="✕" FontSize="10"
                                                               Foreground="White" Opacity="0.85"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                    </Border>

                    <!-- Swap source ↔ single ticked target. -->
                    <Button Grid.Column="4" Padding="6,2" MinHeight="24" MinWidth="0" Margin="8,0,0,0"
                            FontSize="11"
                            Command="{Binding SwapCommand}"
                            IsEnabled="{Binding CanSwap}"
                            IsVisible="{Binding IsSwapVisible}"
                            ToolTip.Tip="Swap source with the single ticked target. Enabled only when exactly one target is ticked.">
                        <TextBlock Text="⇄" FontSize="13"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ──────────────────── Row 1: action bar ──────────────────── -->
            <Border Grid.Row="1" Classes="toolbar" Margin="0,0,0,6">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                    <TextBox Grid.Column="0" Width="320"
                             Text="{Binding ObjectName}"
                             Watermark="Object name">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding ExecuteCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>

                    <!-- DACPAC checkbox inline — hidden when DACPAC isn't configured. -->
                    <CheckBox Grid.Column="1" Margin="14,0,0,0"
                              VerticalAlignment="Center"
                              Content="DACPAC"
                              IsChecked="{Binding StageAsDacpacBranch}"
                              IsEnabled="{Binding !IsBusy}"
                              IsVisible="{Binding DacpacConfigured}"
                              ToolTip.Tip="Write the source definition to the configured DACPAC / SSDT folder after a successful sync. Configured in Settings → DACPAC."/>

                    <Button Grid.Column="2" MinWidth="84" Content="Preview"
                            Command="{Binding PreviewCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            ToolTip.Tip="Fetch source + every ticked target's CREATE definition for the typed object. Pure read; nothing is executed."/>
                    <Button Grid.Column="3" Margin="4,0,0,0" MinWidth="72" Content="Backup"
                            Command="{Binding BackupCommand}" IsEnabled="{Binding !IsBusy}"
                            ToolTip.Tip="Capture source + every ticked target without altering anything."/>
                    <Button Grid.Column="4" Margin="4,0,0,0" MinWidth="84" Content="Sync" Classes="accent"
                            Command="{Binding ExecuteCommand}" IsEnabled="{Binding !IsBusy}"/>
                </Grid>
            </Border>

            <!-- ──────────────── Row 2: last-run info card (the main view) ──────────────── -->
            <Border Grid.Row="2" Classes="card" VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <StackPanel>
                        <TextBlock Classes="sectionTitle" Text="Last run"/>
                        <StackPanel IsVisible="{Binding LastZipPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="Pair zip" Opacity="0.55" FontSize="11" Margin="0,0,0,3"/>
                            <SelectableTextBlock Text="{Binding LastZipPath}" Classes="mono"/>
                        </StackPanel>
                        <TextBlock Opacity="0.5" FontSize="11"
                                   IsVisible="{Binding LastZipPath, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                   Text="No runs yet on this tab."/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Classes="sectionTitle" Text="Backup root"/>
                        <TextBlock Opacity="0.55" FontSize="11" TextWrapping="Wrap"
                                   Text="Files live at {Backups}\{yyyy-MM-dd}\{runStamp}_{role}_{env}\{type}\{name}.sql. Nothing is ever overwritten."/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Classes="sectionTitle" Text="Sync semantics"/>
                        <TextBlock Opacity="0.55" FontSize="11" TextWrapping="Wrap"
                                   Text="If the object exists on a target, the source CREATE is rewritten as ALTER (procs / functions / views / triggers). Otherwise the original CREATE runs. Tables fall through unchanged — table schema migrations aren't auto-rewritten."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Classes="pageStatus">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
