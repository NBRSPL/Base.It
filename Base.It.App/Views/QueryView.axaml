<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Base.It.App.ViewModels"
             xmlns:cfg="using:Base.It.Core.Config"
             x:Class="Base.It.App.Views.QueryView"
             x:DataType="vm:QueryViewModel">

    <DockPanel>
        <ProgressBar DockPanel.Dock="Top" Classes="pageLoader" IsVisible="{Binding IsBusy}"/>

    <!-- Rows: toolbar | query | splitter | results | status.
         Query and Results are *,* so they share the leftover height
         50/50 by default; the GridSplitter between them is draggable
         either way. MinHeight=80 on each so neither pane can be
         dragged to invisibility. -->
    <Grid RowDefinitions="Auto,*,Auto,*,Auto">

        <!-- Same target-picker shape as Batch / Scripts: "To" pill with
             searchable dropdown + inline chip strip + clear / +N overflow. -->
        <Border Grid.Row="0" Classes="toolbar" Margin="0,0,0,6">
            <Grid ColumnDefinitions="*,Auto">

                <Border Grid.Column="0"
                        Background="{DynamicResource App.ElevatedBgBrush}"
                        BorderBrush="{DynamicResource App.StrokeBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="8,4" ClipToBounds="True">
                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left"
                               Text="To" FontSize="11" FontWeight="SemiBold"
                               Opacity="0.85" VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="{DynamicResource App.AccentBrush}"/>
                    <Border DockPanel.Dock="Left" Classes="dropdownShell" Margin="0,0,6,0">
                    <Grid ColumnDefinitions="*,Auto">
                    <AutoCompleteBox Grid.Column="0" x:Name="TargetAddBox" MinWidth="180"
                                     MinimumPrefixLength="0" FilterMode="Contains"
                                     BorderThickness="0" Background="Transparent"
                                     ItemsSource="{Binding TargetCandidateEndpoints}"
                                     SelectedItem="{Binding NextTargetEndpoint, Mode=TwoWay}"
                                     GotFocus="OnEndpointPickerGotFocus"
                                     SelectionChanged="OnTargetAddSelectionChanged"
                                     Watermark="Add target">
                        <AutoCompleteBox.ItemTemplate>
                            <DataTemplate DataType="vm:EndpointPick">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{Binding Color, Converter={x:Static vm:ColorStringBrushConverter.Instance}}"
                                             Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Label}" FontSize="12"/>
                                        <TextBlock Text="{Binding SubLabel}"
                                                   FontSize="10" Opacity="0.55"
                                                   IsVisible="{Binding ShowSubLabel}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>
                    <Button Grid.Column="1"
                            Padding="8,0" MinWidth="0" MinHeight="0"
                            Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Stretch"
                            Click="OnTargetChevronClick"
                            ToolTip.Tip="Show all targets">
                        <TextBlock Text="▾" FontSize="11" Opacity="0.6"
                                   VerticalAlignment="Center"/>
                    </Button>
                    </Grid>
                    </Border>
                    <Button DockPanel.Dock="Left"
                            Padding="6,2" MinWidth="0" MinHeight="22"
                            Margin="0,0,6,0"
                            IsVisible="{Binding TargetSelectedCount}"
                            Command="{Binding ClearTargetsCommand}"
                            ToolTip.Tip="Clear all targets">
                        <TextBlock Text="&#xE894;"
                                   FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                   FontSize="11" Opacity="0.85"/>
                    </Button>
                    <Button DockPanel.Dock="Right"
                            Padding="6,2" MinHeight="22" FontSize="11"
                            Margin="6,0,0,0"
                            IsVisible="{Binding HasCheckedTargetsOverflow}"
                            ToolTip.Tip="More selected targets — click to see / remove">
                        <TextBlock Text="{Binding CheckedTargetsOverflowCount, StringFormat='+{0} more'}"
                                   FontSize="10" FontWeight="SemiBold"/>
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <ItemsControl ItemsSource="{Binding CheckedTargetsOverflow}" MinWidth="220">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:TargetPickVm">
                                            <Border Classes="badge" Margin="2"
                                                    Background="{Binding Color, Converter={x:Static vm:ColorStringBrushConverter.Instance}}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="White"/>
                                                    <Button Click="OnRemoveTargetClick" Tag="{Binding}"
                                                            Padding="3,0" MinWidth="0" MinHeight="0"
                                                            Background="Transparent" BorderThickness="0">
                                                        <TextBlock Text="✕" FontSize="10"
                                                                   Foreground="White" Opacity="0.85"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding CheckedTargetsVisible}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TargetPickVm">
                                    <Border Classes="badge"
                                            Background="{Binding Color, Converter={x:Static vm:ColorStringBrushConverter.Instance}}"
                                            VerticalAlignment="Center"
                                            Padding="6,2"
                                            ToolTip.Tip="{Binding Label}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="White"/>
                                            <Button Click="OnRemoveTargetClick" Tag="{Binding}"
                                                    Padding="3,0" MinWidth="0" MinHeight="0"
                                                    Background="Transparent" BorderThickness="0"
                                                    ToolTip.Tip="Remove this target">
                                                <TextBlock Text="✕" FontSize="10"
                                                           Foreground="White" Opacity="0.85"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
                </Border>

                <Button Grid.Column="1" Margin="6,0,0,0" Content="Run" Classes="accent"
                        Command="{Binding RunCommand}" IsEnabled="{Binding !IsBusy}"
                        ToolTip.Tip="Pick one or more targets, type T-SQL, Run. SELECT shows columns and rows; DML/DDL shows rows affected. Per-target output labelled below."/>
            </Grid>
        </Border>

        <!-- Query editor -->
        <Border Grid.Row="1" Classes="card" Padding="0" MinHeight="80">
            <TextBox Text="{Binding Query}" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="NoWrap" Classes="mono" FontSize="13"
                     Watermark="T-SQL"
                     VerticalContentAlignment="Top" Padding="10,6"
                     BorderThickness="0" Background="Transparent"/>
        </Border>

        <!-- Drag handle between query and results. 6px tall, transparent
             background but the splitter still hit-tests; cursor turns
             into the row-resize affordance on hover. -->
        <GridSplitter Grid.Row="2"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      ResizeDirection="Rows"
                      Background="Transparent"
                      ShowsPreview="False"
                      Margin="0,4"/>

        <!-- Results area: the display -->
        <Border Grid.Row="3" Classes="card" Padding="0" MinHeight="80">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Results" Classes="sectionTitle"
                           Margin="10,8,10,4"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <SelectableTextBlock Text="{Binding Results}" Classes="mono"
                                         Padding="10,4,10,8" TextWrapping="NoWrap"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Classes="pageStatus">
            <TextBlock Text="{Binding Status}"/>
        </Border>
    </Grid>
    </DockPanel>
</UserControl>
