<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Base.It.App.ViewModels"
             x:Class="Base.It.App.Views.ScriptsView"
             x:DataType="vm:ScriptsViewModel">

    <!-- Layout intent (matches Batch's compactness):
           Row 0  context: target popover + add-files / add-folder
           Row 1  ITEMS area: filter + Remove selected / Clear + grid
           Row 2  Execute (the commit action) — pinned at the bottom so
                  it can't be misread as just-another-button up top
           Row 3  status text -->
    <DockPanel>
        <ProgressBar DockPanel.Dock="Top" Classes="pageLoader" IsVisible="{Binding IsBusy}"/>

        <Grid RowDefinitions="Auto,*,Auto,Auto">

            <!-- ─────────── Row 0: targets + actions ─────────── -->
            <!-- Same target-picker shape as Batch: "To" pill with searchable
                 dropdown + inline chip strip + clear / +N overflow. -->
            <Border Grid.Row="0" Classes="toolbar" Margin="0,0,0,6">
                <Grid ColumnDefinitions="*,Auto,Auto">

                    <Border Grid.Column="0"
                            Background="{DynamicResource App.ElevatedBgBrush}"
                            BorderBrush="{DynamicResource App.StrokeBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="8,4" ClipToBounds="True">
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="To" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.85" VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource App.AccentBrush}"/>
                        <Border DockPanel.Dock="Left" Classes="dropdownShell" Margin="0,0,6,0">
                        <Grid ColumnDefinitions="*,Auto">
                        <AutoCompleteBox Grid.Column="0" x:Name="TargetAddBox" MinWidth="180"
                                         MinimumPrefixLength="0" FilterMode="Contains"
                                         BorderThickness="0" Background="Transparent"
                                         ItemsSource="{Binding TargetCandidateEndpoints}"
                                         SelectedItem="{Binding NextTargetEndpoint, Mode=TwoWay}"
                                         GotFocus="OnEndpointPickerGotFocus"
                                         SelectionChanged="OnTargetAddSelectionChanged"
                                         Watermark="Add target">
                            <AutoCompleteBox.ItemTemplate>
                                <DataTemplate DataType="vm:EndpointPick">
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                        <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{Binding Color, Converter={x:Static vm:ColorStringBrushConverter.Instance}}"
                                                 Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Label}" FontSize="12"/>
                                            <TextBlock Text="{Binding SubLabel}"
                                                       FontSize="10" Opacity="0.55"
                                                       IsVisible="{Binding ShowSubLabel}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </AutoCompleteBox.ItemTemplate>
                        </AutoCompleteBox>
                        <Button Grid.Column="1"
                                Padding="8,0" MinWidth="0" MinHeight="0"
                                Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Stretch"
                                Click="OnTargetChevronClick"
                                ToolTip.Tip="Show all targets">
                            <TextBlock Text="▾" FontSize="11" Opacity="0.6"
                                       VerticalAlignment="Center"/>
                        </Button>
                        </Grid>
                        </Border>
                        <Button DockPanel.Dock="Left"
                                Padding="6,2" MinWidth="0" MinHeight="22"
                                Margin="0,0,6,0"
                                IsVisible="{Binding TargetSelectedCount}"
                                Command="{Binding ClearTargetsCommand}"
                                ToolTip.Tip="Clear all targets">
                            <TextBlock Text="&#xE894;"
                                       FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                       FontSize="11" Opacity="0.85"/>
                        </Button>
                        <Button DockPanel.Dock="Right"
                                Padding="6,2" MinHeight="22" FontSize="11"
                                Margin="6,0,0,0"
                                IsVisible="{Binding HasCheckedTargetsOverflow}"
                                ToolTip.Tip="More selected targets — click to see / remove">
                            <TextBlock Text="{Binding CheckedTargetsOverflowCount, StringFormat='+{0} more'}"
                                       FontSize="10" FontWeight="SemiBold"/>
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <ItemsControl ItemsSource="{Binding CheckedTargetsOverflow}" MinWidth="220">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:TargetPickVm">
                                                <Border Classes="badge" Margin="2"
                                                        Background="{Binding Color, Converter={x:Static vm:ColorStringBrushConverter.Instance}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                        <Button Click="OnRemoveTargetClick" Tag="{Binding}"
                                                                Padding="3,0" MinWidth="0" MinHeight="0"
                                                                Background="Transparent" BorderThickness="0">
                                                            <TextBlock Text="✕" FontSize="10"
                                                                       Foreground="White" Opacity="0.85"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CheckedTargetsVisible}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:TargetPickVm">
                                        <Border Classes="badge"
                                                Background="{Binding Color, Converter={x:Static vm:ColorStringBrushConverter.Instance}}"
                                                VerticalAlignment="Center"
                                                Padding="6,2"
                                                ToolTip.Tip="{Binding Label}">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="White"/>
                                                <Button Click="OnRemoveTargetClick" Tag="{Binding}"
                                                        Padding="3,0" MinWidth="0" MinHeight="0"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTip.Tip="Remove this target">
                                                    <TextBlock Text="✕" FontSize="10"
                                                               Foreground="White" Opacity="0.85"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                    </Border>

                    <Button Grid.Column="1" Margin="6,0,0,0" MinWidth="120" Content="+ Add files…"
                            Click="OnAddFilesClick"
                            ToolTip.Tip="Pick one or more .sql files."/>
                    <Button Grid.Column="2" Margin="4,0,0,0" MinWidth="120" Content="+ Add folder…"
                            Click="OnAddFolderClick"
                            ToolTip.Tip="Pick a folder — every .sql below it is added (recursive)."/>
                </Grid>
            </Border>

            <!-- ─────────── Row 1: items area ─────────── -->
            <Border Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True"
                    DragDrop.AllowDrop="True">
                <DockPanel>
                    <!-- Status filter / counters at the top of the items card. -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource App.ToolbarBgBrush}"
                            BorderBrush="{DynamicResource App.StrokeBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,6">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="Files" VerticalAlignment="Center"
                                       FontSize="11" Opacity="0.7" Margin="0,0,8,0"/>
                            <!-- spacer @ col 1 -->
                            <Button Grid.Column="2" Margin="0,0,4,0" Padding="8,2" MinHeight="26"
                                    Content="Export CSV"
                                    Click="OnExportCsvClick"
                                    ToolTip.Tip="Save the current rows (in their displayed order) to a .csv file."/>
                            <Button Grid.Column="3" Margin="0,0,4,0" Padding="8,2" MinHeight="26"
                                    Content="Remove selected"
                                    Command="{Binding RemoveCheckedCommand}"
                                    ToolTip.Tip="Remove rows whose checkbox is ticked."/>
                            <Button Grid.Column="4" Margin="0,0,4,0" Padding="8,2" MinHeight="26"
                                    Content="Clear"
                                    Command="{Binding ClearCommand}"
                                    ToolTip.Tip="Remove every row from the list."/>
                            <TextBlock Grid.Column="5" VerticalAlignment="Center" Margin="12,0,12,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                       Text="{Binding SuccessCount, StringFormat='OK: {0}'}"/>
                            <TextBlock Grid.Column="6" VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Text="{Binding FailCount, StringFormat='Fail: {0}'}"/>
                        </Grid>
                    </Border>

                    <!-- Custom column header. Widths: 44 (checkbox), 50 (#),
                         * (file name), 40 (preview eye), 100 (status), 2* (message). -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource App.ElevatedBgBrush}"
                            BorderBrush="{DynamicResource App.StrokeBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="44,50,*,40,100,2*" Margin="0,7">
                            <TextBlock Grid.Column="1" Text="#" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                            <Button Grid.Column="2"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="6,0,0,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Command="{Binding ToggleSortCommand}" CommandParameter="File"
                                    ToolTip.Tip="Click to sort by file name A→Z / Z→A / clear.">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="File" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding FileSortIndicator}" FontSize="10" Opacity="0.7"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="6,0,0,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Command="{Binding ToggleSortCommand}" CommandParameter="Status"
                                    ToolTip.Tip="Click to sort by status A→Z / Z→A / clear.">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Status" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding StatusSortIndicator}" FontSize="10" Opacity="0.7"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="5" Text="Message" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                       Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                        </Grid>
                    </Border>

                    <!-- Items grid. Empty-state drop hint is overlaid via the
                         Grid below; visibility flips by Items.Count. -->
                    <Grid>
                        <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding Items}"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="None"
                                  GridLinesVisibility="Horizontal"
                                  CanUserReorderColumns="False"
                                  SelectionMode="Extended"
                                  ClipboardCopyMode="ExcludeHeader">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="44" CanUserResize="False" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="vm:ScriptItem">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Margin="0" Padding="0" MinWidth="0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50" IsReadOnly="True"/>
                                <!-- File column: shows the filename only, full path
                                     surfaced via tooltip + right-click menu
                                     (Open in Explorer / Copy location). -->
                                <DataGridTemplateColumn Header="File" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="vm:ScriptItem">
                                            <!-- Border with explicit transparent Background fills the
                                                 whole cell so right-click registers anywhere on the
                                                 row's File column — not just on the text itself.
                                                 Without this the TextBlock only catches hits on the
                                                 painted glyphs and ContextMenu never opens. -->
                                            <Border Background="Transparent"
                                                    Padding="6,0,6,0"
                                                    VerticalAlignment="Stretch"
                                                    HorizontalAlignment="Stretch"
                                                    ToolTip.Tip="{Binding FilePath}">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Open in Explorer"
                                                                  Click="OnOpenInExplorer"
                                                                  Tag="{Binding}"/>
                                                        <MenuItem Header="Open file"
                                                                  Click="OnOpenFile"
                                                                  Tag="{Binding}"/>
                                                        <MenuItem Header="Copy location"
                                                                  Click="OnCopyLocation"
                                                                  Tag="{Binding}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <TextBlock Text="{Binding FileName}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Preview eye: opens file content + per-target diff. -->
                                <DataGridTemplateColumn Header="" Width="40" CanUserResize="False" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="vm:ScriptItem">
                                            <Button Classes="rowIconBtn" Click="OnPreviewClick" Tag="{Binding}"
                                                    ToolTip.Tip="Preview the file content side-by-side with each ticked target's current definition (when the file references a known object).">
                                                <TextBlock Text="&#xE890;"
                                                           FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                                           FontSize="13"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}"  Width="100" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Msg" Width="2*" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="vm:ScriptItem">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Message}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Message}"/>
                                                <Button Grid.Column="1" Margin="6,0,4,0"
                                                        Padding="8,2" MinHeight="22"
                                                        FontSize="10"
                                                        Content="View"
                                                        Click="OnViewErrorClick" Tag="{Binding}"
                                                        IsVisible="{Binding HasError}"
                                                        ToolTip.Tip="Show the full error and copy it to clipboard."/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty-state drop overlay. Visible only when
                             Items is empty; click-through to the grid
                             once files arrive. -->
                        <Border Background="{DynamicResource App.ElevatedBgBrush}"
                                Padding="20"
                                IsHitTestVisible="False"
                                IsVisible="{Binding !Items.Count}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                <TextBlock Text="📄"
                                           FontSize="32" HorizontalAlignment="Center"
                                           Opacity="0.5"/>
                                <TextBlock Text="Drop .sql files or a folder here"
                                           HorizontalAlignment="Center" FontSize="13"
                                           Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                                <TextBlock Text="…or use Add files / Add folder above."
                                           HorizontalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource App.TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ─────────── Row 2: Execute (the commit action) ───────────
                 Pinned to the bottom of the page so it reads as a deliberate
                 commit step, not just another button up in the toolbar.
                 Mirrors Batch's bottom-row Execute placement. -->
            <Border Grid.Row="2" Margin="0,8,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="subtle" VerticalAlignment="Center"
                               Text="{Binding TargetSelectedCount, StringFormat='Will run on {0} target(s).'}"
                               IsVisible="{Binding TargetSelectedCount}"
                               TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Classes="accent"
                            MinWidth="120" MinHeight="30" FontSize="12" FontWeight="SemiBold"
                            Content="Execute"
                            Command="{Binding ExecuteCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            ToolTip.Tip="Run every script against every ticked target."/>
                </Grid>
            </Border>

            <Border Grid.Row="3" Classes="pageStatus">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
