<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Base.It.App.Views"
        xmlns:vm="using:Base.It.App.ViewModels"
        x:Class="Base.It.App.Views.BatchWindow"
        x:DataType="vm:BatchViewModel"
        Title="Base.It — Batch"
        Width="1000" Height="640"
        MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.WindowBgBrush}">

    <!-- Multi-instance Batch window. Owns its own BatchViewModel so the
         user can keep the main tab's state untouched while running a
         second batch (e.g. one prepped manually + another sent from
         Watch). Reuses BatchView verbatim — the view never knew anything
         about its host, so no view-side changes are needed. -->
    <v:BatchView/>
</Window>
