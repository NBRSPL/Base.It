<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Base.It.App.Views.ErrorDetailWindow"
        Title="Error detail"
        Width="780" Height="460"
        MinWidth="480" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.WindowBgBrush}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14">

        <!-- Header: row name (which object failed). -->
        <TextBlock Grid.Row="0" x:Name="TitleBlock"
                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>

        <!-- Subtitle: short status — e.g. "Failed on PROD". -->
        <TextBlock Grid.Row="1" x:Name="SubtitleBlock"
                   Classes="subtle" Margin="0,0,0,8"/>

        <!-- Error body. SelectableTextBlock for keyboard selection + the
             Copy button for everything-at-once. Mono font so call stacks
             and SQL line numbers stay column-aligned. -->
        <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock x:Name="BodyBlock"
                                     Classes="mono"
                                     FontSize="12"
                                     Padding="12,10"
                                     TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Spacing="6">
            <!-- Icon-only Copy. Glyph is Segoe Fluent Icons / MDL2 Copy
                 (E8C8); label moved to the tooltip per the standard
                 "tool-button" convention used elsewhere in the app. -->
            <Button Padding="8,4" MinWidth="36" Click="OnCopy"
                    ToolTip.Tip="Copy">
                <TextBlock Text="&#xE8C8;"
                           FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                           FontSize="13" Opacity="0.85"/>
            </Button>
            <Button Content="Close" MinWidth="84" Click="OnClose" Classes="accent"/>
        </StackPanel>
    </Grid>
</Window>
