<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Base.It.App.Views"
        xmlns:vm="using:Base.It.App.ViewModels"
        x:Class="Base.It.App.Views.BatchPreviewWindow"
        x:DataType="vm:BatchPreviewViewModel"
        Title="{Binding Title}"
        Width="1100" Height="680"
        MinWidth="640" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.WindowBgBrush}">

    <Panel>
    <Grid RowDefinitions="Auto,*,Auto" Margin="14">

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{Binding Title}"
                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <!-- Reusable diff-pane host. Status text + per-endpoint failure
             block + side-by-side pane rendering all live in PaneDiffView
             so the inline Sync screen and this standalone Window share
             one renderer. The change-navigation arrows (▲ / ▼) and
             counter render inside the rightmost pane's header — plain
             glyphs, no chrome, level with the per-pane Copy icon. F3 /
             Shift+F3 fire the same commands from code-behind. -->
        <v:PaneDiffView Grid.Row="1" x:Name="PaneHost"
                        DataContext="{Binding}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Spacing="6">
            <!-- Per-pane Copy lives on each pane's header (see BuildHeader
                 in PaneDiffView). This footer only owns the Close action. -->
            <Button Content="Close" MinWidth="80" Click="OnClose" Classes="accent"/>
        </StackPanel>
    </Grid>

    <!-- Universal find overlay — same shape MainWindow uses so the
         feature feels identical from any window. Ctrl+F opens it,
         Esc / ✕ closes. Match highlighting is done by re-populating the
         pane inlines whenever the text changes. -->
    <Border x:Name="FindOverlay"
            IsVisible="False"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,12,16,0"
            Padding="10,6"
            Background="{DynamicResource App.ElevatedBgBrush}"
            BorderBrush="{DynamicResource App.StrokeStrongBrush}"
            BorderThickness="1"
            CornerRadius="8"
            BoxShadow="0 6 20 0 #40000000">
        <Grid ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">
            <TextBlock Grid.Column="0" Text="Find" FontSize="11" Opacity="0.7"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="FindBox"
                     Width="240" MinHeight="26"
                     Watermark="Type to filter the current page"
                     KeyDown="OnFindBoxKeyDown"
                     TextChanged="OnFindBoxTextChanged"/>
            <Button  Grid.Column="2" Margin="6,0,0,0"
                     Padding="6,2" MinWidth="0" MinHeight="26"
                     Click="OnFindClose"
                     ToolTip.Tip="Close (Esc)">
                <TextBlock Text="✕" FontSize="11"/>
            </Button>
        </Grid>
    </Border>
    </Panel>
</Window>
