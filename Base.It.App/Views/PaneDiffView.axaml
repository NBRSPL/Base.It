<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Base.It.App.ViewModels"
             x:Class="Base.It.App.Views.PaneDiffView"
             x:DataType="vm:BatchPreviewViewModel">

    <!-- Reusable diff-pane host. Binds to a BatchPreviewViewModel and
         renders its Panes side-by-side with the same LineAligner red-line
         highlighting BatchPreviewWindow uses. Hosted in both the standalone
         BatchPreviewWindow AND inline on the merged Sync screen so the two
         entry points share one renderer (and one bug surface). -->
    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Status (per-load summary: count + diffs / errors) on the left;
             the whitespace toggle on the right. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" Text="{Binding Status}"
                       Classes="subtle" VerticalAlignment="Center"
                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <CheckBox Grid.Column="1" Content="Ignore spaces &amp; tabs"
                      IsChecked="{Binding IgnoreWhitespace}"
                      ToolTip.Tip="Treat lines that differ only in spaces/tabs as unchanged."/>
        </Grid>

        <!-- Endpoint-failure block: only renders when at least one
             endpoint couldn't be loaded. -->
        <Border Grid.Row="1" Padding="8" Margin="0,4,0,8"
                CornerRadius="4"
                Background="{DynamicResource App.FieldErrorBgBrush}"
                BorderBrush="{DynamicResource App.FieldErrorBorderBrush}"
                BorderThickness="1"
                IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <SelectableTextBlock Text="{Binding LoadError}"
                                 Classes="errorText"
                                 TextWrapping="Wrap"/>
        </Border>

        <!-- Pane host — code-behind populates ColumnDefinitions + child
             controls based on Panes. -->
        <Border Grid.Row="2" Classes="card" Padding="2">
            <Grid x:Name="PanesHost"/>
        </Border>
    </Grid>
</UserControl>
